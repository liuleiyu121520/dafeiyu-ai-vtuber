# 大肥鱼 AI 虚拟主播 · macOS Docker 环境变量示例
# 复制成 .env 后按需填写：cp .env.example .env
# .env 已被 .gitignore 忽略，不会进版本库。

# ============================================================
# 大模型（OpenAI 兼容网关 / 智谱）
# ============================================================
# 聊天类型：chatgpt（OpenAI 兼容，推荐）/ zhipu / mock（离线测试，不花钱）
CHAT_TYPE=chatgpt

# OpenAI 兼容网关。智谱的地址是 https://open.bigmodel.cn/api/paas/v4
OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 你的 API Key。留空则容器启动后请到 WebUI 里填。
OPENAI_API_KEY=

# 模型名（智谱免费模型：glm-4.7-flash）
LLM_MODEL=glm-4.7-flash
LLM_TEMPERATURE=0.9
LLM_MAX_TOKENS=4096
LLM_TOP_P=1.0
LLM_STREAM=true

# 直接走 zhipu provider 时填这两项（CHAT_TYPE=zhipu 才用）
ZHIPU_API_KEY=
ZHIPU_MODEL=chatglm_lite

# ============================================================
# 语音合成
# ============================================================
# edge-tts（免费，需要外网）/ fish_audio（音色更像大肥鱼，需要 Key）/ mock_tts（离线测试）
TTS_PROVIDER=edge-tts

EDGE_TTS_VOICE=zh-CN-XiaoyiNeural
EDGE_TTS_RATE=+0%
EDGE_TTS_VOLUME=+0%

FISH_AUDIO_KEY=
FISH_AUDIO_REFERENCE_ID=fe50cdf3040449298470d58ff0991e1d
FISH_AUDIO_MODEL=s2.1-pro-free

# ============================================================
# 直播平台
# ============================================================
# dy  = 通过本机弹幕 Hub（:8888）收弹幕（Docker 推荐，配合 BARRAGE_MODE）
# dy2 = 容器内直连抖音网页端 wss（需要外网 + 房间号）
PLATFORM=dy
# 直播间号（https://live.douyin.com/<这个数字>）
ROOM_ID=278333

# ============================================================
# 音频播放
# ============================================================
# browser = 音频通过 HTTP 交给 OBS 浏览器源播放（Docker 唯一可行方案）
# pygame  = 容器内本机声卡（Docker Desktop 没有声卡，会静音）
PLAY_AUDIO_PLAYER=browser
PLAY_AUDIO_ENABLE=true

# ============================================================
# 舞台 / 字幕
# ============================================================
LIVE2D_ENABLE=true
LIVE2D_PORT=12345
LIVE2D_MODEL=大肥鱼
CAPTION_ENABLE=true
CAPTION_API=http://127.0.0.1:5500

# ============================================================
# 互动
# ============================================================
BGM_ENABLE=true
BGM_VOLUME=0.3
SONG_ENABLE=true
GIFT_THANKS_ENABLE=true
ENTRANCE_WELCOME_ENABLE=true
FOLLOW_THANKS_ENABLE=true

# 回复长度（字符）
REPLY_MAX_CHARS=200
REPLY_MAX_LEN=80

# ============================================================
# 容器行为
# ============================================================
WEBUI_PORT=8081
API_PORT=8082
CAPTION_PORT=5500
BARRAGE_HUB_PORT=8888

# mock = 启动本机弹幕 Hub（可用 scripts/macos/mock-chat.sh 注入模拟弹幕）
# hub  = 启动 Hub，但等外部采集器连进来
# none = 不启动 Hub（用 PLATFORM=dy2 直连，或不需要弹幕）
BARRAGE_MODE=mock

ENABLE_CAPTION_SERVICE=1
# 启动时把上面的环境变量写进 config.json（幂等）
APPLY_ENV_CONFIG=1
# WebUI 起来后自动「一键运行」把 main.py 拉起来
AUTO_RUN=1
